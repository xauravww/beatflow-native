# ── BeatFlow backend configuration ───────────────────────────────────────
# Copy to `.env` (or set these in your process manager / pm2 / systemd
# env block). The backend does NOT load `.env` automatically — it reads
# real environment variables, so export them or set them in pm2/systemd.
#
# All variables are OPTIONAL — the server works with sensible defaults.

# HTTP port the server listens on (default: 3000)
# PORT=3000

# Path to a Netscape-format cookies.txt exported from your browser for
# youtube.com (e.g. the "Get cookies.txt LOCALLY" extension). Fixes
# "Sign in to confirm you're not a bot" on datacenter/VPS IPs.
# Recommended on a VPS, not needed on a residential IP.
# YT_COOKIES=/path/to/cookies.txt

# SOCKS proxy URL for yt-dlp (e.g. Cloudflare WARP).
# Expects a proxy URL — NOT true/false. A non-empty value is only used
# when that port is actually listening (the backend probes it first);
# an empty string forces yt-dlp to connect directly, which is faster
# on a residential IP (no WARP running).
#   Default (used when unset):  socks5://127.0.0.1:1080
#   YTDLP_PROXY=socks5://127.0.0.1:1080
#   Disable (go direct):        YTDLP_PROXY=

# Explicit path to a yt-dlp binary. Default lookup order:
# backend/bin/yt-dlp (from `npm run setup`), then system yt-dlp on PATH.
# YTDLP_BIN=/usr/local/bin/yt-dlp
